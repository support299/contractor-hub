DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# sqlite (default) or postgres: postgres://user:pass@localhost:5432/contractor_hub
DATABASE_URL=
MEDIA_ROOT=
# True = no login gate (legacy). Production: False
HUB_OPEN_ACCESS=False
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# GoHighLevel Private Integration (phone OTP → Login Otp custom field → workflow SMS)
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
OTP_EXPIRY_MINUTES=5
OTP_REQUEST_COOLDOWN_SECONDS=60

# service-creator (Jobber task create). Do not put Jobber tokens here.
SERVICE_CREATOR_BASE_URL=https://site.cleanonthego.com

# Django Channels. Empty = InMemoryChannelLayer (local only, single process).
# Prod: redis://user:pass@host:6379/0  (or rediss:// for TLS)
REDIS_URL=

# Upload size limits (bytes) — allow ~300MB handbooks
DATA_UPLOAD_MAX_MEMORY_SIZE=314572800
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# S3 media (set USE_S3=True in production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# Optional CloudFront / custom domain for the bucket
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_EXPIRE=3600
